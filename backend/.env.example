# Server
NODE_ENV=development
PORT=5000

# Database (replace with your actual credentials)
DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/finance_manager
POSTGRES_PRISMA_URL=postgresql://postgres:your-password-here@localhost:5432/finance_manager

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=your-cookie-secret-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URL (for password reset link)
CLIENT_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@cointoss.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Vercel Blob (file uploads)
BLOB_READ_WRITE_TOKEN=

# Vercel KV (rate limit store - production only)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron secret (Vercel cron endpoint auth)
CRON_SECRET=
