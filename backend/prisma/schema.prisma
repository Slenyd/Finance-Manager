generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// Application user roles
enum UserRole {
  USER
  ADMIN
}

/// Transaction flow types
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// Budget recurrence periods
enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Recurring transaction intervals
enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Notification severity levels
enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

/// Core user account. Owns all financial data.
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            UserRole @default(USER)
  isVerified      Boolean  @default(false) @map("is_verified")
  isLocked        Boolean  @default(false) @map("is_locked")
  failedLoginAttempts Int  @default(0) @map("failed_login_attempts")
  lockUntil       DateTime?
  resetToken      String?  @map("reset_token")
  resetTokenExpires DateTime?
  currency        String   @default("USD") @map("currency")
  locale          String   @default("en-US") @map("locale")
  tokenVersion    Int      @default(0) @map("token_version")
  refreshTokens   RefreshToken[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  savingsGoals    SavingsGoal[]
  recurringTransactions RecurringTransaction[]
  notifications   Notification[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Single financial record (income, expense, or transfer).
model Transaction {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  categoryId    String?         @map("category_id")
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  type          TransactionType
  date          DateTime
  paymentMethod String?         @map("payment_method")
  notes         String?
  receiptUrl    String?         @map("receipt_url")
  isRecurring   Boolean         @default(false) @map("is_recurring")
  tags          String[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, date, type])
  @@map("transactions")
}

/// User-defined or default category grouping for transactions and budgets.
model Category {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  name          String
  icon          String        @default("circle")
  color         String        @default("#6366f1")
  type          TransactionType
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

/// Spending limit per category per period.
model Budget {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  categoryId String       @map("category_id")
  limit      Decimal      @db.Decimal(12, 2)
  period     BudgetPeriod
  startDate  DateTime     @map("start_date")
  endDate    DateTime     @map("end_date")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([userId, categoryId, period])
  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

/// Savings target with progress tracking.
model SavingsGoal {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  targetAmount   Decimal  @map("target_amount") @db.Decimal(12, 2)
  currentAmount  Decimal  @default(0) @map("current_amount") @db.Decimal(12, 2)
  deadline       DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("savings_goals")
}

/// Template for auto-generating transactions on a schedule.
model RecurringTransaction {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  categoryId  String            @map("category_id")
  amount      Decimal           @db.Decimal(12, 2)
  description String
  type        TransactionType
  interval    RecurringInterval
  dayOfMonth  Int?
  dayOfWeek   Int?
  startDate   DateTime          @map("start_date")
  endDate     DateTime?
  nextDate    DateTime          @map("next_date")
  isActive    Boolean           @default(true) @map("is_active")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@index([nextDate])
  @@map("recurring_transactions")
}

/// In-app notification for the user.
model Notification {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean         @default(false) @map("is_read")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

/// JWT refresh token with family-based theft detection.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  family    String
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}