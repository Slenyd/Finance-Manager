# Copy this file to .env.docker and fill in real values before running docker-compose
# NEVER commit .env.docker to version control

# Database
POSTGRES_PASSWORD=

# JWT (generate strong secrets: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cookies
COOKIE_SECRET=

# Optional overrides (defaults shown)
# CORS_ORIGIN=http://localhost:80
# CLIENT_URL=http://localhost:80